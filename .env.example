# Copie ce fichier vers .env et remplis les valeurs. Ne commite jamais .env.

# Token du bot Discord (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# ID du salon Discord où vous jouez (mode développeur -> clic droit sur le salon -> copier l'identifiant)
CHANNEL_ID=

# Infomaniak AI API (pour les embeddings via leur API OpenAI-compatible)
# Trouver dans: https://developer.infomaniak.com/docs/api/post/2/ai/%7Bproduct_id%7D/openai/v1/embeddings
# product_id: L'ID de votre produit Infomaniak AI (ex: 123456)
INFOMANIAK_PRODUCT_ID=
# API Key: Votre clé API Infomaniak
INFOMANIAK_API_KEY=